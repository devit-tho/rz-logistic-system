model Shipment {
  id        String      @id @db.ObjectId @default(auto())  @map("_id") 
  name            String         @map("shipment_name")
  jobsheetNo      String?         @map("jobsheet_no")
  billOfLadingNo  String?         @map("bill_of_lading_no")
  packages        Int
  etd             DateTime?
  eta             DateTime?
  totalM3         Float          @map("total_m3")
  totalContainers Int            @default(0) @map("total_containers") 
  grossWeight     Float          @default(0) @map("gross_weight")
  completedDate   DateTime?      @map("completed_date")
  description     String?        @map("description")
  // packageList     String?        @map("package_list")
  trackingNumber  String?        @map("tracking_number")
  reference       String?        
  status          ShipmentStatus @default(PENDING)

  user           User          @relation(fields: [userId], references: [id])
  userId         String           @map("user_id")
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId     String           @map("customer_id")
  shippingLine   ShippingLine? @relation(fields: [shippingLineId], references: [id], onDelete: SetNull)
  shippingLineId String?          @map("shipping_line_id")
  broker         Broker?       @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  brokerId       String?          @map("broker_id")
  createdAt      DateTime      @default(now()) @map("created_at")

  cargos         Cargo[]       @relation("ShipmentToCargos")
  trucking       TruckingManagement[]

  @@map("shipments")
}
